{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "analytics": false,
    "useDaemonProcess": false,
    "sync": {
        "applyChanges": true
    },
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*",
            "sharedGlobals"
        ],
        "production": [
            "default",
            "!{projectRoot}/test/**/*",
            "!{projectRoot}/**/*.spec.ts",
            "!{projectRoot}/**/*.stories.ts",
            "!{projectRoot}/vitest.config.*",
            "!{projectRoot}/eslint.config.*",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/README.md"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/pnpm-lock.yaml",
            "{workspaceRoot}/.nvmrc"
        ]
    },
    "targetDefaults": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "production",
                "^production"
            ],
            "cache": true
        },
        "test": {
            "inputs": [
                "default",
                "^production"
            ],
            "cache": true
        },
        "lint": {
            "inputs": [
                "default",
                "{workspaceRoot}/biome.json",
                "{workspaceRoot}/eslint.config.mjs"
            ],
            "cache": true
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "default",
                "^production"
            ],
            "cache": true
        }
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json",
                    "buildDepsName": "build-deps",
                    "watchDepsName": "watch-deps"
                }
            }
        }
    ]
}
