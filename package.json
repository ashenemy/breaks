{
    "name": "@market/source",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "Мультивендор-маркетплейс строительных товаров (Армения): монорепо Nx",
    "packageManager": "pnpm@12.9.1",
    "engines": {
        "node": ">=24.21.0 <25",
        "pnpm": ">=12.9.1 <13"
    },
    "scripts": {
        "nx": "nx",
        "graph": "nx graph --file=tmp/graph.json",
        "build": "nx run-many -t build --all",
        "test": "nx run-many -t test --all",
        "lint": "nx run-many -t lint --all",
        "typecheck": "nx run-many -t typecheck --all",
        "affected": "nx affected -t lint typecheck test build",
        "affected:build": "nx affected -t build",
        "affected:lint": "nx affected -t lint",
        "affected:test": "nx affected -t test",
        "affected:typecheck": "nx affected -t typecheck",
        "check:generated": "node tools/generated/check-generated-projects.mjs",
        "test:boundaries": "vitest run --root tools boundaries",
        "test:tools": "vitest run --root tools",
        "ci": "pnpm check:generated && pnpm test:tools && nx affected -t lint typecheck test build"
    },
    "dependencies": {},
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@eslint/js": "10.0.1",
        "@nx/devkit": "23.2.1",
        "@nx/eslint": "23.2.1",
        "@nx/eslint-plugin": "23.2.1",
        "@nx/js": "23.2.1",
        "@nx/plugin": "23.2.1",
        "@nx/vitest": "23.2.1",
        "@swc-node/register": "1.11.1",
        "@swc/core": "1.15.47",
        "@swc/helpers": "0.5.23",
        "@types/node": "24.19.1",
        "@vitest/coverage-v8": "4.1.11",
        "eslint": "10.12.0",
        "jsonc-eslint-parser": "2.4.2",
        "nx": "23.2.1",
        "tslib": "2.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2",
        "vitest": "4.1.11"
    }
}
