{
    "name": "@market/tooling",
    "version": "0.0.1",
    "description": "Генераторы воркспейса: обёртки над официальными плагинами Nx со структурой и правилами проекта",
    "private": true,
    "type": "commonjs",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "@market/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "@nx/devkit": "23.2.1",
        "@nx/js": "23.2.1",
        "tslib": "2.8.1"
    },
    "generators": "./generators.json",
    "files": [
        "dist",
        "!**/*.tsbuildinfo",
        "generators.json"
    ]
}
