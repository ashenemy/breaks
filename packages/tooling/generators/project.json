{
    "name": "tooling-generators",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/tooling/generators/src",
    "projectType": "library",
    "tags": ["scope:shared", "type:tooling", "platform:api"],
    "metadata": {
        "description": "Generators of the workspace: wrappers over official Nx plugins",
        "generator": "@nx/plugin:plugin"
    },
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "packages/tooling/generators/dist",
                "main": "packages/tooling/generators/src/index.ts",
                "tsConfig": "packages/tooling/generators/tsconfig.lib.json",
                "rootDir": "packages/tooling/generators/src",
                "generatePackageJson": false,
                "assets": [
                    {
                        "input": "./packages/tooling/generators/src",
                        "glob": "**/!(*.ts)",
                        "output": "."
                    },
                    {
                        "input": "./packages/tooling/generators/src",
                        "glob": "**/*.d.ts",
                        "output": "."
                    }
                ]
            }
        },
        "test": {
            "executor": "@market/tooling:vitest",
            "outputs": ["{projectRoot}/test-output"],
            "options": {},
            "configurations": {
                "ci": {
                    "coverage": true
                }
            }
        }
    }
}
